{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "module": "commonjs",
    "jsx": "react",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "types": [],
    "rootDir": "src",
    "outDir": "lib",
    "customConditions": ["react-native-legacy-deep-imports"]
  },
  "include": ["src"]
}
